# Copy this file to .env and fill in your values. NEVER commit .env.

# --- MySQL (source system) ---
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=olist_source
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=change_me
MYSQL_EXTRACT_USER=extractor
MYSQL_EXTRACT_PASSWORD=change_me

# --- Google Cloud ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=US
GCS_BUCKET=your-bucket-name
BQ_RAW_DATASET=raw
BQ_STAGING_DATASET=staging
BQ_MARTS_DATASET=marts
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-service-account.json

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me

# --- Alerts (optional) ---
SLACK_WEBHOOK_URL=